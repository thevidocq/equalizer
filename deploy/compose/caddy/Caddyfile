{
	email {$EQ_ACME_EMAIL}
	# no Caddy admin endpoint
	admin off
	on_demand_tls {
		ask http://gateway:9090/tls/allowed
	}
}

# Plain HTTP: certificate challenges (handled by Caddy first), then HTTPS.
http:// {
	redir https://{host}{uri} permanent
}

# Protected sites: any domain, but a certificate only for the domains of
# published maps (the gateway answers /tls/allowed). Unknown hosts get no
# certificate, so no TLS handshake.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip

	# Caddy passes the client IP in X-Forwarded-For; the gateway accepts it
	# only from this network (EQ_TRUSTED_PROXIES).
	reverse_proxy {
		dynamic a {
			name gateway
			port 8080
			refresh 10s
		}
		lb_policy round_robin
		health_uri /readyz
		health_port 9090
		health_interval 10s
	}

	log {
		output stdout
		format json
	}
}

# The panel, for customers: the static UI and its /v1 API (panel-ui proxies
# /v1 to panel-api). The internal API never leaves the control network.
{$EQ_PANEL_DOMAIN} {
	encode zstd gzip
	handle /v1/internal/* {
		respond 404
	}
	handle {
		reverse_proxy panel-ui:8080
	}

	log {
		output stdout
		format json
	}
}

# Connectors open their tunnel here (Upgrade: equalizer-tunnel/1). Only the
# tunnel path is published; everything else answers 404.
{$EQ_RELAY_DOMAIN} {
	handle /v1/tunnel {
		reverse_proxy {
			dynamic a {
				name tunnel-relay
				port 8081
				refresh 10s
			}
			lb_policy round_robin
		}
	}
	handle {
		respond 404
	}

	log {
		output stdout
		format json
	}
}
