# Copy to .env and fill in. Do not commit .env.

# Protected sites need no setting here: each published map brings its
# domain, and Caddy gets its certificate on the first visit (only for
# domains with a published map). Point the site's DNS record to the VPS.
# Public domain of the relay: connectors open their tunnel here (HTTPS, 443)
EQ_RELAY_DOMAIN=relay.example.com
# Public domain of the panel, used by customers and in invitation emails
EQ_PANEL_DOMAIN=panel.example.com
# Email for Let's Encrypt certificates
EQ_ACME_EMAIL=admin@example.com

# Gateway replicas (at least 2, to verify there is no local state)
EQ_GATEWAY_REPLICAS=2
# debug, info, warn, error
EQ_LOG_LEVEL=info
# Where the gateway reads maps. Unset: every published map from the panel.
# Empty (EQ_MAP_URL=): maps/current.json signed by hand (lab without panel;
# put meta.public_domain in the map to get a certificate).
#EQ_MAP_URL=
# host:port reachable in direct mode, e.g. lab apps (vuln-app:80). Empty:
# every tenant map must use a connector.
EQ_DIRECT_DESTINATIONS=
# Exposure check of protected sites on their old IP (0 turns it off)
EQ_EXPOSURE_INTERVAL=1h
# Identifier of the map signing key
EQ_MAP_KEY_ID=k1
# Networks from which the gateway accepts X-Forwarded-For (Caddy's Docker network)
EQ_TRUSTED_PROXIES=172.16.0.0/12

# Invitation emails. smtp (default), off, or log (development only: writes
# the invitation links to the panel-api log). The SMTP password goes in
# secrets/smtp.password (an empty file when the server needs none).
EQ_MAIL_MODE=smtp
# host:port; 587 uses STARTTLS, 465 implicit TLS
EQ_SMTP_ADDR=smtp.example.com:587
EQ_SMTP_USER=equalizer@example.com
EQ_MAIL_FROM=Equalizer <equalizer@example.com>

# Password of the Grafana admin user
EQ_GRAFANA_PASSWORD=changeme

# VPS user and group for files created by eqtool (id -u, id -g)
EQ_UID=1000
EQ_GID=1000
