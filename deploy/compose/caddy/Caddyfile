{
	email {$EQ_ACME_EMAIL}
	# niente pagina di amministrazione di Caddy
	admin off
}

{$EQ_GATEWAY_DOMAIN} {
	encode zstd gzip

	# Caddy passa l'IP del client in X-Forwarded-For; il gateway lo accetta
	# solo da questa rete (EQ_TRUSTED_PROXIES).
	reverse_proxy {
		dynamic a {
			name gateway
			port 8080
			refresh 10s
		}
		lb_policy round_robin
		health_uri /readyz
		health_port 9090
		health_interval 10s
	}

	log {
		output stdout
		format json
	}
}
