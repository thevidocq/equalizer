# Copia in .env e compila. Non committare .env.

# Dominio pubblico del gateway (record DNS verso la VPS)
EQ_GATEWAY_DOMAIN=gw.example.com
# Email per i certificati Let's Encrypt
EQ_ACME_EMAIL=admin@example.com

# Repliche del gateway (almeno 2 per verificare l'assenza di stato locale)
EQ_GATEWAY_REPLICAS=2
# debug, info, warn, error
EQ_LOG_LEVEL=info
# Identificativo della chiave di firma delle mappe
EQ_MAP_KEY_ID=k1
# Reti da cui il gateway accetta X-Forwarded-For (rete Docker di Caddy)
EQ_TRUSTED_PROXIES=172.16.0.0/12

# Password dell'utente admin di Grafana
EQ_GRAFANA_PASSWORD=cambiami

# Utente e gruppo della VPS per i file creati da eqtool (id -u, id -g)
EQ_UID=1000
EQ_GID=1000
