{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equalizer.ai/schema/events/log-1.0.json",
  "title": "Equalizer application log line",
  "description": "Application log line (single-line JSON on stdout). Shared by all services.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "level", "service", "msg"],
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "level": { "enum": ["debug", "info", "warn", "error"] },
    "service": {
      "enum": ["gateway", "tunnel-relay", "connector", "orchestrator", "panel-api", "panel-ui", "agent", "source-reader"]
    },
    "instance": { "type": "string" },
    "module": { "type": "string", "description": "Internal module, e.g. pipeline.rewrite" },
    "tenant": { "type": ["string", "null"] },
    "app": { "type": ["string", "null"] },
    "request_id": { "type": ["string", "null"] },
    "trace_id": { "type": ["string", "null"] },
    "span_id": { "type": ["string", "null"] },
    "map_version": { "type": ["integer", "null"] },
    "msg": { "type": "string" },
    "error": { "type": ["string", "null"] },
    "detail": {
      "type": "object",
      "description": "Extra data, already masked: never cookies, Authorization, passwords, tokens or personal fields in clear."
    }
  }
}
