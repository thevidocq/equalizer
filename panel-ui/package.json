{
  "name": "equalizer-panel-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../schema/api/panel-api.yaml -o src/shared/api/schema.d.ts",
    "check:api": "openapi-typescript ../schema/api/panel-api.yaml -o /tmp/eq-schema.d.ts && diff -q /tmp/eq-schema.d.ts src/shared/api/schema.d.ts",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@tanstack/react-query": "^5.108.0",
    "js-yaml": "^4.3.2",
    "openapi-fetch": "^0.13.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
