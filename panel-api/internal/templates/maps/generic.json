{
 "meta": {
  "schema": "gateway-map/1.0",
  "tenant": "x",
  "app": "x",
  "version": 1,
  "status": "draft"
 },
 "legacy": {
  "base_url": "__BASE_URL__",
  "reach": {
   "mode": "connector",
   "connector_id": "__CONNECTOR__",
   "address": "__ADDRESS__",
   "allow": [
    "__ADDRESS__"
   ]
  },
  "timeout_ms": 10000
 },
 "roles": {
  "anonymous": "guest",
  "list": {
   "guest": {}
  }
 },
 "defaults": {
  "rate_limit": {
   "per_ip": "120/min"
  },
  "legacy_budget": {
   "max_concurrency": 10
  },
  "string": {
   "max_length": 200
  }
 },
 "types": {
  "slug": {
   "base": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$",
   "deny": [
    "admin",
    "administrator",
    "api",
    "backup",
    "backups",
    "cgi-bin",
    "config",
    "console",
    "cpanel",
    "install",
    "jsonapi",
    "manager",
    "phpmyadmin",
    "plesk",
    "pma",
    "private",
    "server-info",
    "server-status",
    "setup",
    "test",
    "tmp",
    "vendor",
    "webmail",
    "wp-admin",
    "wp-login",
    "xmlrpc"
   ]
  },
  "id": {
   "base": "int",
   "min": 1,
   "max": 999999999
  },
  "search": {
   "base": "string",
   "max_length": 100,
   "pattern": "^[^<>{}\\x00-\\x1f]{1,100}$"
  }
 },
 "routes": [
  {
   "id": "home",
   "path": "/",
   "method": "GET",
   "roles": [
    "guest"
   ],
   "legacy_request": {
    "method": "GET",
    "path": "/"
   },
   "render": "faithful",
   "origin": "human",
   "risk": "low"
  },
  {
   "id": "page",
   "path": "/{slug}",
   "method": "GET",
   "roles": [
    "guest"
   ],
   "legacy_request": {
    "method": "GET",
    "path": "/{{params.slug}}"
   },
   "render": "faithful",
   "origin": "human",
   "risk": "low",
   "params": {
    "slug": {
     "type": "slug"
    }
   }
  },
  {
   "id": "sub_page",
   "path": "/{section}/{slug}",
   "method": "GET",
   "roles": [
    "guest"
   ],
   "legacy_request": {
    "method": "GET",
    "path": "/{{params.section}}/{{params.slug}}"
   },
   "render": "faithful",
   "origin": "human",
   "risk": "low",
   "params": {
    "section": {
     "type": "slug"
    },
    "slug": {
     "type": "slug"
    }
   }
  }
 ],
 "assets": [
  {
   "prefix": "/css/",
   "types": [
    "text/css",
    "application/javascript",
    "text/javascript",
    "image/png",
    "image/jpeg",
    "image/gif",
    "image/svg+xml",
    "image/webp",
    "image/x-icon",
    "font/woff",
    "font/woff2",
    "font/ttf",
    "application/font-woff"
   ]
  },
  {
   "prefix": "/js/",
   "types": [
    "text/css",
    "application/javascript",
    "text/javascript",
    "image/png",
    "image/jpeg",
    "image/gif",
    "image/svg+xml",
    "image/webp",
    "image/x-icon",
    "font/woff",
    "font/woff2",
    "font/ttf",
    "application/font-woff"
   ]
  },
  {
   "prefix": "/fonts/",
   "types": [
    "text/css",
    "application/javascript",
    "text/javascript",
    "image/png",
    "image/jpeg",
    "image/gif",
    "image/svg+xml",
    "image/webp",
    "image/x-icon",
    "font/woff",
    "font/woff2",
    "font/ttf",
    "application/font-woff"
   ]
  },
  {
   "prefix": "/images/",
   "types": [
    "image/png",
    "image/jpeg",
    "image/gif",
    "image/webp",
    "image/svg+xml",
    "application/pdf"
   ]
  },
  {
   "prefix": "/img/",
   "types": [
    "image/png",
    "image/jpeg",
    "image/gif",
    "image/webp",
    "image/svg+xml",
    "application/pdf"
   ]
  }
 ],
 "_template": {
  "name": "Generic site",
  "description": "Home, pages one and two levels deep and the usual folders for styles, scripts, images and fonts. A start for custom PHP, ASP or JSP sites: add their real pages and forms."
 }
}
