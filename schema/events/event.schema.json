{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equalizer.ai/schema/events/event-1.0.json",
  "title": "Equalizer security event",
  "description": "Security event emitted by the gateway, relay or probes. Same format for the event store and the SIEM.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ts", "type", "service", "tenant", "app"],
  "properties": {
    "schema": { "const": "event/1.0" },
    "ts": { "type": "string", "format": "date-time" },
    "type": {
      "enum": [
        "request.served",
        "request.blocked",
        "field.rejected",
        "ratelimit.hit",
        "behavior.alert",
        "parse.failed",
        "legacy.error",
        "connector.down",
        "exposure.alert"
      ]
    },
    "reason": {
      "type": ["string", "null"],
      "description": "Short reason, e.g. route_not_mapped, method_not_allowed, type_mismatch, authz_denied."
    },
    "service": { "enum": ["gateway", "tunnel-relay", "connector", "probe"] },
    "instance": { "type": "string" },
    "tenant": { "type": "string" },
    "app": { "type": "string" },
    "map_version": { "type": ["integer", "null"] },
    "route": { "type": ["string", "null"], "description": "Id of the matched route, null if not mapped." },
    "request_id": { "type": "string" },
    "trace_id": { "type": "string" },
    "src_ip": { "type": "string" },
    "session": { "type": ["string", "null"], "description": "Session hash, never the identifier in clear." },
    "user": { "type": ["string", "null"], "description": "User hash or internal id, never personal data." },
    "method": { "type": "string" },
    "path": { "type": "string", "maxLength": 2048 },
    "status": { "type": "integer" },
    "latency_ms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gateway": { "type": "number" },
        "legacy": { "type": "number" }
      }
    },
    "detail": { "type": "object" }
  }
}
