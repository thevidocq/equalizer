{
	email {$EQ_ACME_EMAIL}
	# no Caddy admin endpoint
	admin off
}

{$EQ_GATEWAY_DOMAIN} {
	encode zstd gzip

	# Caddy passes the client IP in X-Forwarded-For; the gateway accepts it
	# only from this network (EQ_TRUSTED_PROXIES).
	reverse_proxy {
		dynamic a {
			name gateway
			port 8080
			refresh 10s
		}
		lb_policy round_robin
		health_uri /readyz
		health_port 9090
		health_interval 10s
	}

	log {
		output stdout
		format json
	}
}
